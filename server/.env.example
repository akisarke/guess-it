# Local server environment template. Never copy local values to production.

NODE_ENV=development
DATABASE_URL=postgresql://localhost:5432/guessit
TEST_DATABASE_URL=postgresql://localhost:5432/guessit_test
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SAME_SITE=lax
CLIENT_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
PORT=3001
TRUST_PROXY=loopback

# Set to true when a trusted reverse proxy terminates TLS and forwards plain HTTP to
# this server, so `x-forwarded-proto` arrives as http and the HTTPS check cannot pass.
# Only enable it when the proxy genuinely enforces HTTPS upstream. Leave false on
# platforms that forward the original protocol (Render, Fly, Cloud Run).
TLS_TERMINATED_BY_PROXY=false

# Hack Club OAuth. Leave blank locally to disable the provider.
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=
HACKCLUB_REDIRECT_URI=http://localhost:3001/api/auth/hackclub/callback

# Optional providers. Leave blank locally when unused.
RESEND_API_KEY=
EMAIL_FROM=Guess It <noreply@example.test>
# Comma-separated Gemini API keys; on 429 quota exhaustion the server rotates to the next key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

AVATAR_UPLOAD_DIR=uploads/avatars
DAILY_GEN_ENABLED=true
DAILY_GEN_HOUR_UTC=0
DAILY_GEN_MINUTE_UTC=5
DAILY_TOPIC_REPEAT_DAYS=14

# Rate limits, format "<requests>:<windowMs>". In development an unset limit falls
# back to 1 request per minute; production refuses to boot without all twelve.
LIMIT_LOGIN_IP=10:600000
LIMIT_LOGIN_ACCOUNT=5:900000
LIMIT_ANONYMOUS_IP=20:60000
LIMIT_FORGOT_PASSWORD_IP=5:3600000
LIMIT_FORGOT_PASSWORD_ACCOUNT=3:3600000
LIMIT_RESET_PASSWORD_IP=5:3600000
LIMIT_RESET_PASSWORD_TOKEN_PREFIX=5:3600000
LIMIT_SIGNUP_IP=5:3600000
LIMIT_GENERATION_IP=10:86400000
LIMIT_GENERATION_USER=10:86400000
LIMIT_AVATAR_IP=10:3600000
LIMIT_AVATAR_USER=10:3600000

# Duel WebSocket guards. Production refuses to boot without all three.
DUEL_MAX_PAYLOAD_BYTES=65536
DUEL_COMMAND_LIMIT=30
DUEL_COMMAND_WINDOW_MS=60000

# Seed/reset CLI values. Keep unset unless running an explicit local operation.
OWNER_USER_ID=
OWNER_DISPLAY_NAME=local-owner
OWNER_EMAIL=
OWNER_PASSWORD=
RESET_USERS_CONFIRM=

# Production requires all of the following, with no defaults: DATABASE_URL,
# SESSION_SECRET, SESSION_COOKIE_SAME_SITE, CLIENT_ORIGINS, APP_URL, TRUST_PROXY,
# the three HACKCLUB_* values, all twelve LIMIT_* values, and all three DUEL_* values.
# Missing any one of them stops the server on boot rather than starting insecurely.
