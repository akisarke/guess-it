# The client needs no environment variables for local development: it is served by
# Vite on http://localhost:5173 and proxies /api and /uploads to the server on
# port 3001.
#
# Server configuration lives in server/.env. Start by copying server/.env.example:
#
#   cp server/.env.example server/.env
#
# VITE_API_URL is optional. Set it only when the client should call an API that is
# not same-origin (for example a deployed backend).
# VITE_API_URL=https://guessit.akisarke.xyz
